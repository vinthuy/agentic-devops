# 分发模板：本仓库已直接启用 .github/workflows/ci.yml，本文件保留给其他仓库复制使用。
# 启用方式：
#   1. 让 git 凭据具备 workflow 权限：gh auth refresh -h github.com -s workflow
#   2. cp ci/github-workflow.yml.template .github/workflows/ci.yml
#   3. git add .github/workflows/ci.yml && git push
#
# 之所以保留模板形式：GitHub 拒绝没有 workflow scope 的 OAuth 令牌推送
# .github/workflows/*，而 Gitee 不受此限制。模板可以正常版本化。
#
# 注意：Windows runner 默认以 CRLF 检出，gofmt 会把所有 .go 判为未格式化。
# 复制本模板的同时必须带上仓库根的 .gitattributes（* text=auto eol=lf）。
name: ci

on:
  push:
    branches: [master]
  pull_request:
    branches: [master]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    name: test (${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: gofmt
        shell: bash
        run: |
          unformatted="$(gofmt -l .)"
          if [ -n "$unformatted" ]; then
            echo "以下文件未通过 gofmt，请运行 gofmt -w:"
            echo "$unformatted"
            exit 1
          fi

      - name: vet
        run: go vet ./...

      - name: build
        run: go build ./...

      - name: test
        run: go test ./... -count=1

  bench-manifest:
    name: benchmark manifest
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      # 基准清单与 fixture 的完整性检查，不需要模型与 API key。
      - name: validate manifest and fixtures
        run: go test ./internal/bench -run TestCommittedManifestIsValid -count=1 -v
